# Copy to .env and fill in. Generate secrets with:
#   openssl rand -hex 32   -> JWT_SECRET (32+ characters required)
#   openssl rand -hex 16   -> ENCRYPTION_KEY (hex-encodes to exactly 32 ASCII chars = 32 bytes)

# Signs session cookies. Must be at least 32 characters. Changing this
# invalidates all logged-in sessions.
JWT_SECRET=

# Encrypts stored agent tokens and server passwords at rest. Must be EXACTLY
# 32 bytes/characters. Losing this key makes stored credentials unrecoverable
# - back it up.
ENCRYPTION_KEY=

# Bootstrap admin account, only used the very first time the app starts
# (when the users table is empty). Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to true when serving over HTTPS (e.g. behind a TLS reverse proxy) so
# session cookies are marked Secure. Leave off for plain-HTTP LAN use.
#COOKIE_SECURE=true

# Optional: the address Flametender is reached on, used when generating
# deployment stacks. Leave unset to infer it from the provisioner.
#PUBLIC_HOST=

# Optional, and normally unset. Every server raised through the wizard is
# a supervisor-mode flameagent, and power/restarts/updates/logs all go
# over the agent's API — so this console needs no docker socket. It is
# here only for a game server deployed as a plain container with no agent
# beside it, and should point at a scoped socket proxy, never at the host
# socket (see docker-compose.yml).
#DOCKER_HOST=tcp://docker-proxy:2375

# Optional: one-click provisioning through the shared Ilmari host service
# (github.com/safwyls/ilmari). Register flametender as a client there and
# paste the matching token here; without these the Raise-a-server wizard
# is absent and servers are registered by hand.
#ILMARI_URL=http://ilmari:8820
#ILMARI_TOKEN=
