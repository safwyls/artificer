# Copy to .env and fill in. Generate secrets with:
#   openssl rand -hex 32   -> JWT_SECRET (32+ characters required)
#   openssl rand -hex 16   -> ENCRYPTION_KEY (hex-encodes to exactly 32 ASCII chars = 32 bytes)

# Signs session cookies. Must be at least 32 characters. Changing this
# invalidates all logged-in sessions.
JWT_SECRET=

# Encrypts stored agent tokens and server passwords at rest. Must be EXACTLY
# 32 bytes/characters. Losing this key makes stored credentials unrecoverable
# - back it up.
ENCRYPTION_KEY=

# Bootstrap admin account, only used the very first time the app starts
# (when the users table is empty). Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to true when serving over HTTPS (e.g. behind a TLS reverse proxy) so
# session cookies are marked Secure. Leave off for plain-HTTP LAN use.
#COOKIE_SECURE=true

# Optional: the address Wildskeeper is reached on, used when generating
# deployment stacks. Leave unset to infer it from the provisioner.
#PUBLIC_HOST=
